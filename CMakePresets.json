{
  "version": 5,
  "configurePresets": [
    {
      "name": "android_app_base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake"
        },
        "CMAKE_MAKE_PROGRAM": {
          "type": "FILEPATH",
          "value": "$env{ANDROID_NDK}/prebuilt/windows-x86_64/bin/make"
        },
        "ANDROID_PLATFORM": "31",
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "ANDROID": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "OFF",
        "BUILD_ANDROID_APK": "ON"
      }
    },
    {
      "name": "android_app_profile",
      "displayName": "android_app_profile",
      "description": "Android APK PGO instrument build",
      "inherits": "android_app_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HORIZON_PGO_GENERATE": "ON"
      }
    },
    {
      "name": "android_app_release",
      "displayName": "android_app_release",
      "description": "Android APK PGO optimized build",
      "inherits": "android_app_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HORIZON_PGO_USE": "ON"
      }
    },
    {
      "name": "msvcwin64_base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "ON"
      }
    },
    {
      "name": "msvcwin64_profile",
      "displayName": "msvcwin64_profile",
      "description": "Windows MSVC PGO instrument build",
      "inherits": "msvcwin64_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HORIZON_PGO_GENERATE": "ON"
      }
    },
    {
      "name": "msvcwin64_release",
      "displayName": "msvcwin64_release",
      "description": "Windows MSVC PGO optimized build",
      "inherits": "msvcwin64_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HORIZON_PGO_USE": "ON"
      }
    },
    {
      "name": "clangwin64_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "ON"
      }
    },
    {
      "name": "clangwin64_profile",
      "displayName": "clangwin64_profile",
      "description": "Windows Clang PGO instrument build",
      "inherits": "clangwin64_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HORIZON_PGO_GENERATE": "ON"
      }
    },
    {
      "name": "clangwin64_release",
      "displayName": "clangwin64_release",
      "description": "Windows Clang PGO optimized build",
      "inherits": "clangwin64_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HORIZON_PGO_USE": "ON"
      }
    },
    {
      "name": "macos_base",
      "hidden": true,
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "OFF"
      }
    },
    {
      "name": "macos_profile",
      "displayName": "macos_profile",
      "description": "macOS PGO instrument build",
      "inherits": "macos_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HORIZON_PGO_GENERATE": "ON"
      }
    },
    {
      "name": "macos_release",
      "displayName": "macos_release",
      "description": "macOS PGO optimized build",
      "inherits": "macos_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HORIZON_PGO_USE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android_app_profile",
      "configurePreset": "android_app_profile",
      "targets": ["apk_all"]
    },
    {
      "name": "android_app_release",
      "configurePreset": "android_app_release",
      "targets": ["apk_all"]
    },
    {
      "name": "msvcwin64_profile",
      "configurePreset": "msvcwin64_profile",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvcwin64_release",
      "configurePreset": "msvcwin64_release",
      "configuration": "Release"
    },
    {
      "name": "clangwin64_profile",
      "configurePreset": "clangwin64_profile"
    },
    {
      "name": "clangwin64_release",
      "configurePreset": "clangwin64_release"
    },
    {
      "name": "macos_profile",
      "configurePreset": "macos_profile",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos_release",
      "configurePreset": "macos_release",
      "configuration": "Release"
    }
  ]
}
