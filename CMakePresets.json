{
  "version": 5,
  "configurePresets": [
    {
      "name": "android_framework",
      "displayName": "android_framework",
      "description": "Build android framework (Vulkan only)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake"
        },
        // only for windows
        "CMAKE_MAKE_PROGRAM": {
          "type": "FILEPATH",
          "value": "$env{ANDROID_NDK}/prebuilt/windows-x86_64/bin/make.exe"
        },
        "ANDROID_PLATFORM": "31",
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "ANDROID": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "OFF"
      }
    },
    {
      "name": "android_app",
      "displayName": "Android APK",
      "description": "Build Android APKs for all samples",
      "inherits": "android_framework",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_ANDROID_APK": "ON"
      }
    },
    {
      "name": "msvcwin64",
      "displayName": "msvcwin64",
      "description": "Build for Windows x64 with MSVC",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "ON"
      }
    },
    {
      "name": "clangwin64",
      "displayName": "clangwin64",
      "description": "Build for Windows x64 with Clang + Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN": "ON",
        "USE_DX12": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android_framework",
      "configurePreset": "android_framework"
    },
    {
      "name": "android_app",
      "configurePreset": "android_app",
      "targets": ["apk_all"]
    },
    {
      "name": "msvcwin64",
      "configurePreset": "msvcwin64",
      "configuration": "Debug"
    },
    {
      "name": "clangwin64",
      "configurePreset": "clangwin64",
      "configuration": "Debug"
    }
  ]
}
