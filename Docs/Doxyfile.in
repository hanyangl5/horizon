PROJECT_NAME           = Horizon
PROJECT_BRIEF          = "Horizon runtime API reference"
OUTPUT_DIRECTORY       = "@HORIZON_DOXYGEN_OUTPUT_DIR@"

INPUT                  = @HORIZON_DOXYGEN_INPUTS@
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.md
RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = "@HORIZON_DOXYGEN_MAINPAGE@"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF           = NO

BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@ENGINE_DIR@/Source"
STRIP_FROM_INC_PATH    = "@ENGINE_DIR@/Source"
SHORT_NAMES            = NO

INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_BY_SCOPE_NAME     = YES

SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

QUIET                  = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = YES

HAVE_DOT               = NO
