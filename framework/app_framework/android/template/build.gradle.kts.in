plugins {
    id("com.android.application")
}

android {
    namespace = "@SAMPLE_PACKAGE@"
    compileSdk = 36

    defaultConfig {
        applicationId = "@SAMPLE_PACKAGE@"
        minSdk = 31
        targetSdk = 36
        versionCode = 1
        versionName = "1.0"
        ndk {
            abiFilters += "arm64-v8a"
            debugSymbolLevel = "FULL"
        }
    }

    sourceSets {
        getByName("main") {
            jniLibs.srcDirs("@NATIVE_LIB_DIR@")
        }
